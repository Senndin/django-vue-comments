# Приклад змінних оточення. Скопіювати у `.env` і за потреби змінити значення.
# Файл `.env` у репозиторій не потрапляє.

# Django
# На проді згенерувати свій: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
# За замовчуванням — робочий режим: статику й медіа віддає nginx, сторінок із трасуванням
# помилок немає. Поставте True для розробки без Docker, а також якщо запускаєте
# `npm run dev`: тоді Django сам роздає /media через проксі Vite.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Домени, з яких працює адмінка (через кому). На сервері — ваш домен зі схемою.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
# Увімкніть разом із сертифікатом: редирект на https, secure-куки і HSTS.
DJANGO_HTTPS=False

# PostgreSQL. POSTGRES_HOST: `db` — у Docker Compose, `localhost` — для запуску без Docker.
POSTGRES_DB=comments
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis. У Docker Compose хост — `redis`, без Docker — `localhost`.
# Номер бази дописує застосунок: 0 — кеш, 1 — черга, 2 — WebSocket.
REDIS_URL=redis://localhost:6379

# Пошта. За замовчуванням листи друкуються в лог контейнера. Щоб надсилати
# по-справжньому, розкоментуйте SMTP-рядки і заповніть їх.
DEFAULT_FROM_EMAIL=comments@example.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True

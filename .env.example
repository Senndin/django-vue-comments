# Приклад змінних оточення. Скопіювати у `.env` і за потреби змінити значення.
# Файл `.env` у репозиторій не потрапляє.

# Django
# На проді згенерувати свій: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. POSTGRES_HOST: `db` — у Docker Compose, `localhost` — для запуску без Docker.
POSTGRES_DB=comments
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
